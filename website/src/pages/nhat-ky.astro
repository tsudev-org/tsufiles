---
import TaiLieu from '../components/TaiLieu.astro';
import { changelogMoiNhat, RELEASES_URL, renderMd } from '../lib/noi-dung';
// Sáu phiên bản gần nhất; bản đầy đủ ở CHANGELOG.md trên GitHub.
const { html } = renderMd('CHANGELOG.md', { md: changelogMoiNhat(6), haCap: 0 });
---
<TaiLieu tieuDe="Nhật ký thay đổi" moTa="Nhật ký thay đổi của TsuFiles theo từng phiên bản: tính năng mới, định dạng mới, sửa lỗi, bản vá bảo mật và cải tiến giao diện tiếng Việt." duongDan="/nhat-ky/" nguon="CHANGELOG.md">
  <h1>Nhật ký thay đổi</h1>
  <p>Nhật ký dưới đây giữ nguyên tiếng Anh; chi tiết từng bản (tiếng Việt, khóa ký cập nhật, gia cố bảo mật) ghi trong ghi chú của từng <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">bản phát hành trên GitHub</a>.</p>
  <div lang="en"><Fragment set:html={html} /></div>
</TaiLieu>
