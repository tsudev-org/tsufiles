---
import Trang from '../layouts/Trang.astro';
import { banMoiNhat, REPO_URL } from '../lib/noi-dung';
// Sinh lúc build bởi scripts/cai-bang-lenh.mjs (phiếu 20261114-02) - không sửa tay.
import caiBangLenh from '../data/cai-bang-lenh.generated.json';

// Bố cục chữ ký `cong-cu` (tsudev-standards DESIGN_SYSTEM mục 1.2.2): vùng thao tác chính - tải bộ cài cho Windows,
// chọn hệ điều hành khác hoặc chép lệnh cài - nằm ngay màn đầu, căn giữa; ảnh ứng dụng và giới thiệu xếp phía dưới.
const ban = await banMoiNhat();
const mb = (b: number) => `${(b / 1024 / 1024).toFixed(0)} MB`;
const setupWin = ban?.goi.find((g) => g.ten.endsWith('-win-Setup.exe'));
const heKhac = [
  { ten: 'macOS (chip Apple)', neo: 'goi-osx-arm64' },
  { ten: 'macOS (Intel)', neo: 'goi-osx-x64' },
  { ten: 'Linux x64', neo: 'goi-linux-x64' },
  { ten: 'Linux ARM64', neo: 'goi-linux-arm64' },
].filter((h) => !ban || ban.goi.some((g) => `goi-${g.nenTang}` === h.neo));
const lenhScoop = caiBangLenh.kenh.find((k) => k.he === 'windows')?.lenh.join('\n');
// Ví dụ đường chuyển đổi (minh hoạ, không phải vùng thả thật: website không nhận tệp)
const viDu = [['HEIC', 'JPG'], ['PDF', 'DOCX'], ['MKV', 'MP4'], ['HWP', 'DOCX']];
const buoc = [
  { t: 'Giữ phím và kéo tệp', d: 'Giữ Ctrl (Option trên macOS) rồi kéo một hay nhiều tệp, từ trình quản lý tệp hoặc từ trình duyệt.' },
  { t: 'Vòng tròn mở ra tại con trỏ', d: 'Chỉ những định dạng hợp với tệp đang kéo mới hiện. Nhấn Tab hoặc lăn chuột để lật sang công cụ ít dùng.' },
  { t: 'Thả vào định dạng muốn có', d: 'Tệp kết quả nằm cạnh tệp gốc (hoặc thư mục bạn chọn). Không hộp thoại, không bước thừa.' },
];
const tinhNang = [
  { t: 'Hơn 260 định dạng', d: 'Ảnh, PDF, Word, Excel, PowerPoint, HWP, video, âm thanh, phụ đề, sách điện tử, tệp nén, CAD, phông chữ, bản đồ, 3D.' },
  { t: 'Không cần Microsoft Office', d: 'Phần lớn chuyển đổi chạy bằng bộ đọc, bộ ghi có sẵn. Engine tùy chọn (LibreOffice, FFmpeg, Pandoc...) chỉ tải khi cần.' },
  { t: 'Nhiều tệp cùng lúc', d: 'Chuyển song song cả loạt tệp. Đường đi nhiều bước (HWP sang HWPX sang DOCX) được tự tìm.' },
  { t: 'Preset theo loại tệp', d: 'Mỗi loại tệp một thanh công cụ riêng: chất lượng, kích thước, DPI, trang PDF, nén, video, thư mục và tên tệp đầu ra.' },
  { t: 'Thư mục theo dõi', d: 'Tệp nào rơi vào thư mục đã chọn đều được chuyển tự động, kết quả gom vào một chỗ.' },
  { t: 'Dòng lệnh tsufiles', d: 'Dùng chung engine và preset với ứng dụng, có đầu ra JSON cho script. Xem trang Dòng lệnh.' },
  { t: 'Tiếng Việt đầy đủ', d: 'Lần chạy đầu theo ngôn ngữ và chế độ sáng/tối của máy: giao diện, trình cài đặt, dòng lệnh đều có tiếng Việt và 21 ngôn ngữ khác.' },
  { t: 'Sáng, tối, màu nhấn riêng', d: 'Chọn chế độ nền, màu nhấn và độ trong của vòng tròn theo ý bạn.' },
];
const nhom = [
  'Ảnh: JPG, PNG, WEBP, AVIF, HEIC, RAW máy ảnh, PSD...',
  'PDF: sang DOCX, ảnh, PPTX; ghép, tách, nén',
  'Văn bản: DOCX, DOC, ODT, RTF, EML, MSG, HWP',
  'Bảng tính: XLSX, XLS, ODS, CSV, JSON',
  'Trình chiếu: PPTX, PPT, ODP sang PDF, ảnh',
  'Video, âm thanh: MP4, MKV, MP3, FLAC... (FFmpeg)',
  'Sách điện tử: EPUB, MOBI, AZW3, CBZ',
  'Tệp nén, CAD, phông chữ, dữ liệu, bản đồ, 3D',
];
const baoMat = [
  { t: 'Tệp không rời khỏi máy', d: 'Không tải tệp lên máy chủ nào, không thu thập dữ liệu, không cần tài khoản. Chuyển đổi chạy được khi không có mạng.' },
  { t: 'Bản cập nhật có chữ ký riêng', d: 'Danh sách SHA-256 của mỗi bản phát hành được ký ECDSA P-256 bằng khóa riêng của TsuFiles; sai chữ ký thì từ chối.' },
  { t: 'Chống tệp độc hại', d: 'Chặn giải nén thoát thư mục ("zip slip"), tệp "bom", tài liệu tự tải nội dung từ mạng hay đọc tệp khác trên máy.' },
  { t: 'Kiểm tra liên tục', d: 'Mỗi thay đổi đi qua CodeQL, gitleaks, soát lỗ hổng thư viện và hàng nghìn bài kiểm thử trên Windows, Linux, macOS.' },
];
---
<Trang moTa="TsuFiles: chuyển đổi tệp ngoại tuyến bằng kéo thả, hơn 260 định dạng, giao diện tiếng Việt, miễn phí, mã nguồn mở, không tải tệp lên mạng." duongDan="/">
  <section class="mo-dau mo-dau--cong-cu">
    <!-- Hoạ tiết chữ ký `quy-dao`: vòng quỹ đạo TĨNH quanh vùng thao tác, vẽ bằng --accent/--glow, phủ <= 15% (mục 1.2.4) -->
    <svg class="hoa-tiet" viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g class="hoa-tiet__vong">
        <ellipse cx="600" cy="470" rx="560" ry="170" transform="rotate(-8 600 470)" />
        <ellipse cx="600" cy="470" rx="430" ry="130" transform="rotate(-8 600 470)" />
        <ellipse cx="600" cy="470" rx="300" ry="92" transform="rotate(-8 600 470)" />
      </g>
      <g class="hoa-tiet__diem">
        <circle cx="62" cy="530" r="9" /><circle cx="1110" cy="350" r="12" /><circle cx="214" cy="372" r="7" />
        <circle cx="1008" cy="580" r="8" /><circle cx="330" cy="540" r="5" /><circle cx="880" cy="400" r="6" />
      </g>
    </svg>
    <div class="khung mo-dau__luoi">
      <div>
        <span class="nhan">{ban ? `Phiên bản ${ban.phienBan} · ${ban.ngay}` : 'Sắp có bản phát hành đầu tiên'}</span>
        <h1>Kéo, thả, xong. <span class="chu-tim">Chuyển đổi tệp</span> ngay trên máy bạn</h1>
        <p class="mo-dau__phu">TsuFiles đổi định dạng ảnh, PDF, tài liệu, video, âm thanh và hơn thế nữa chỉ bằng một cú kéo thả. Miễn phí, mã nguồn mở, giao diện tiếng Việt, và tệp của bạn không bao giờ bị tải lên mạng.</p>
      </div>

      <div class="thao-tac" aria-labelledby="thao-tac-tieu-de">
        <h2 id="thao-tac-tieu-de" class="an-di">Tải và cài TsuFiles</h2>
        <ul class="thao-tac__vi-du" aria-label="Ví dụ chuyển đổi">
          {viDu.map(([tu, sang]) => <li>{tu}<span aria-hidden="true"> → </span><span class="an-di"> sang </span><b>{sang}</b></li>)}
          <li class="thao-tac__them"><a href="/dinh-dang/">+ hơn 260 định dạng</a></li>
        </ul>
        {setupWin ? (
          <a class="nut nut--chinh nut--lon" href={setupWin.url}>Tải cho Windows <span class="nut__phu">bộ cài .exe · {mb(setupWin.kichThuoc)}</span></a>
        ) : (
          <a class="nut nut--chinh nut--lon" href="/tai-ve/">Tải TsuFiles</a>
        )}
        {heKhac.length > 0 && (
          <p class="thao-tac__he">Hệ khác: {heKhac.map((h, i) => <>{i > 0 && ' · '}<a href={`/tai-ve/#${h.neo}`}>{h.ten}</a></>)}</p>
        )}
        {lenhScoop && (
          <div class="thao-tac__lenh">
            <div class="lenh-cai__dau">
              <p>hoặc cài bằng Scoop</p>
              <button type="button" class="nut nut--phu nut--nho" data-chep="lenh-nhanh" hidden><span data-nhan>Chép</span><span class="an-di"> lệnh Scoop</span></button>
            </div>
            <pre tabindex="0"><code id="lenh-nhanh">{lenhScoop}</code></pre>
          </div>
        )}
        <p class="thao-tac__ghi-chu">Windows 10/11 · Linux · macOS <a class="khong-ngat" href="/tai-ve/#macos">tạm dừng</a> · giấy phép MIT · <a class="khong-ngat" href="/tai-ve/#kiem-tra">kiểm tra SHA-256</a></p>
      </div>
    </div>
  </section>

  <section class="muc muc--anh" aria-label="Ảnh ứng dụng">
    <div class="khung">
      <figure class="minh-hoa">
        <img src="/anh/page-home-vi.png" alt="Màn hình Trang chủ của TsuFiles: vùng thả tệp và danh sách chuyển đổi gần đây, menu bên trái bằng tiếng Việt" width="1080" height="820" loading="lazy">
        <figcaption>Trang chủ: thả tệp vào đây hoặc giữ Ctrl rồi kéo ở bất kỳ đâu</figcaption>
      </figure>
    </div>
  </section>

  <section class="muc" aria-labelledby="cach-dung">
    <div class="khung">
      <h2 id="cach-dung">Ba bước, không cần mở ứng dụng</h2>
      <p class="muc__dan">TsuFiles chạy nền. Bạn làm việc trong trình quản lý tệp như thường lệ, cần đổi định dạng thì kéo.</p>
      <ol class="buoc">
        {buoc.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="muc" aria-labelledby="tinh-nang">
    <div class="khung">
      <h2 id="tinh-nang">Tính năng</h2>
      <p class="muc__dan">Đầy đủ tính năng chuyển đổi, giao diện tiếng Việt và các lớp bảo vệ riêng của TsuDEV.</p>
      <ul class="the-luoi">
        {tinhNang.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="dinh-dang">
    <div class="khung">
      <h2 id="dinh-dang">Định dạng nào cũng có đường</h2>
      <p class="muc__dan">Danh sách đầy đủ, kèm định dạng cần engine tùy chọn, ở trang <a href="/dinh-dang/">Định dạng hỗ trợ</a>.</p>
      <ul class="nhom-dinh-dang">
        {nhom.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="anh-chup">
    <div class="khung">
      <h2 id="anh-chup">Ảnh chụp</h2>
      <p class="muc__dan">Giao diện tiếng Việt, chế độ sáng.</p>
      <div class="anh-luoi">
        <figure>
          <img src="/anh/page-toolbar-vi.png" alt="Trang Thanh công cụ vòng tròn: sắp xếp các ô định dạng bằng kéo thả, mỗi loại tệp một hồ sơ" width="1080" height="820" loading="lazy">
          <figcaption>Sắp xếp vòng tròn, mỗi loại tệp một hồ sơ</figcaption>
        </figure>
        <figure>
          <img src="/anh/page-presets-vi.png" alt="Trang Preset: danh sách preset chuyển đổi có sẵn và do bạn tạo" width="1080" height="820" loading="lazy">
          <figcaption>Preset: chất lượng, kích thước, thư mục đầu ra</figcaption>
        </figure>
        <figure>
          <img src="/anh/page-watch-vi.png" alt="Trang Thư mục theo dõi: quy tắc tự chuyển đổi tệp mới trong một thư mục" width="1080" height="820" loading="lazy">
          <figcaption>Thư mục theo dõi tự chuyển đổi tệp mới</figcaption>
        </figure>
        <figure>
          <img src="/anh/page-engines-vi.png" alt="Trang Engine: trạng thái các engine có sẵn và engine tùy chọn có thể cài thêm" width="1080" height="820" loading="lazy">
          <figcaption>Engine tùy chọn: chỉ tải khi bạn cần</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="muc" aria-labelledby="bao-mat">
    <div class="khung">
      <h2 id="bao-mat">Riêng tư và an toàn</h2>
      <p class="muc__dan">Hạng sản phẩm C theo quy ước TsuDEV: chạy ngoại tuyến, không tài khoản. Chi tiết ở trang <a href="/bao-mat/">Bảo mật</a>.</p>
      <ul class="the-luoi">
        {baoMat.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="nguon-goc">
    <div class="khung">
      <h2 id="nguon-goc">Mã nguồn và ghi công</h2>
      <p class="muc__dan">TsuFiles do TsuDEV xây dựng và phát triển độc lập tại Việt Nam, mã nguồn mở theo giấy phép MIT (thông báo bản quyền đầy đủ ở trang <a href="/ban-quyen/">Bản quyền</a>). Muốn ủng hộ TsuFiles, xem trang <a href="/ung-ho/">Ủng hộ</a>.</p>
      <div class="mo-dau__nut">
        <a class="nut nut--phu" href={REPO_URL} target="_blank" rel="noopener noreferrer">Mã nguồn trên GitHub</a>
        <a class="nut nut--phu" href="/ban-quyen/">Bản quyền</a>
      </div>
    </div>
  </section>
</Trang>
